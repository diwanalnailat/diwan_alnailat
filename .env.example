# Values belong in the runtime secret settings, never public JavaScript.
SITE_OWNER_EMAIL=
# One-time admin provisioning; phone in international +country format.
DIWAN_ADMIN_PHONE=
APP_BASE_URL=
AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_TRANSCRIBE_MODEL=
AI_DAILY_REQUEST_LIMIT=100
WHATSAPP_ENABLED=false
WHATSAPP_PROVIDER=green_api
GREEN_API_URL=https://7107.api.greenapi.com
GREEN_API_INSTANCE=710722692511
GREEN_API_TOKEN=
GREEN_API_PHONE=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_API_VERSION=
WHATSAPP_LANGUAGE=ar
WHATSAPP_OTP_TEMPLATE=
WHATSAPP_NOTIFICATION_TEMPLATE=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# Random secret, at least 32 characters.
OTP_SECRET=
# Enables server-validated WhatsApp OTP sessions after the sessions migration.
DIWAN_AUTH_ENABLED=false

# Setting DATABASE_URL connects the local workspace to Supabase, without login UI.
# These values are server-only. Never prefix credentials with NEXT_PUBLIC_.
DATABASE_URL=
SUPABASE_SECRET_KEY=
# Existing legacy service-role keys are also supported.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=diwan-files
# Use the project origin, without /rest/v1/.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
